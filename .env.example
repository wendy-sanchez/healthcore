# ── HealthCore Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# NEVER commit .env to version control (.env is in .gitignore).

# ── JWT Authentication ──────────────────────────────────────────────
# REQUIRED: Secret key for signing JWT tokens. Generate a random 32+ char string:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=30

# ── Supabase (PostgreSQL) ───────────────────────────────────────────
# REQUIRED: Full connection string.
# Example: postgresql://user:password@host.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── 4Geeks AI (DeepSeek-v4) Embeddings API ─────────────────────────
# REQUIRED for RAG and agent functionality.
API_KEY=
HOST=
QDRANT_URL=http://localhost:6333

# ── Resend (Email Service) ──────────────────────────────────────────
# REQUIRED for password reset flow.
RESEND_API_KEY=

# ── Agent Configuration ─────────────────────────────────────────────
# JWT token used by agent tools to authenticate against the inventory API.
AGENT_JWT_TOKEN=

# ── Rate Limiting (optional, defaults shown) ────────────────────────
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MINUTES=60
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AGENT_RATE_LIMIT_MAX_REQUESTS=30
AGENT_RATE_LIMIT_WINDOW_SECONDS=60
PASSWORD_RESET_AUDIT_ENABLED=true

# ── OpenAPI Docs ────────────────────────────────────────────────────
# Set to "true" to enable /docs and /redoc endpoints in production.
ENABLE_DOCS=false

# ── Redis / Celery ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MCP Server ──────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=9100
MCP_TRANSPORT=streamable-http
MCP_PUBLIC_URL=
MCP_DEV_TOKEN=
MCP_AGENT_TOKEN=
MCP_SKIP_AUTH=false

# ── Incidents API ───────────────────────────────────────────────────
INCIDENTS_DB_PATH=

# ── Telemetry ───────────────────────────────────────────────────────
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
TELEMETRY_CONTROL_ENDPOINT=
TELEMETRY_USER_KEY=